{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint:wording": {
      "dependsOn": [
        "build"
      ]
    },
    "@dabsproof/cli#test": {
      "dependsOn": [
        "build"
      ]
    },
    "@dabsproof/demo-seller#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "passThroughEnv": [
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "@dabsproof/demo-seller#test": {
      "dependsOn": [
        "build"
      ]
    },
    "@dabsproof/runner#test": {
      "dependsOn": [
        "^build",
        "@dabsproof/demo-seller#test"
      ]
    }
  }
}
